{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // An assets-only Worker: no Worker script, so pages are served as static assets and never run
  // Worker code (free-tier constraint, hub decision 2026-11-03-site-deliverable-contract).
  // Until cutover, no route or custom domain points at it: its traffic is workers.dev's, the preview.
  "name": "christianjmills-site",
  "compatibility_date": "2026-10-20",
  "send_metrics": false,
  // Each uploaded version gets its own preview URL on workers.dev, where it is checked before it is
  // promoted (tools/deploy.ts). Both hosts answer with noindex (public/_headers).
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Files are served by their names and nothing else: the old site's addresses (`/about.html`,
    // `/posts/x/index.html`) answer 200 where they are, as they did on GitHub Pages, where the
    // default would redirect them. A folder's page and the slash come from the rules
    // tools/archive-merge.ts writes to dist/_redirects (hub decision
    // 2026-11-03-christianjmills-legacy-urls).
    "html_handling": "none"
  }
}
