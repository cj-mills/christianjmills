# Files under /_astro/ carry a hash of their contents in their names, so a browser that has one
# never needs to ask for it again (hub decision 2026-11-10-christianjmills-page-scripts-in-one-file).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The preview is kept out of search engines: the Worker's workers.dev host and each version's
# preview host (<version>-christianjmills-site.<subdomain>.workers.dev) answer with noindex. The
# same files serve the live domain, which this rule doesn't match, so the switch is the host's,
# not the build's (hub project file, Open work 4, Platform).
https://:host.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
