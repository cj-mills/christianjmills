---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The page's Markdown copy for agents, if it has one. */
  markdown?: string;
}
const { title, description, markdown } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Christian Mills' ? title : `${title} · Christian Mills`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta name="color-scheme" content="light dark" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">Christian Mills</a>
      <nav aria-label="Site">
        <ul>
          <li><a href="/">Writing</a></li>
          <li><a href="/categories/">Categories</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Prototype build of the relaunched site. Placeholder design tokens; not the final design.</p>
    </footer>
  </body>
</html>
