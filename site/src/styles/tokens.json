{
  "$description": "PLACEHOLDER design tokens for the Astro prototype. The custom design system that replaces 'Classical' has not been designed; these values only prove the pipeline (tokens -> CSS custom properties, light and dark). Format: a subset of the W3C Design Tokens (DTCG) format; colour tokens carry a value per scheme.",
  "color": {
    "paper": { "$type": "color", "$value": { "light": "#fbfaf7", "dark": "#15171c" } },
    "surface": { "$type": "color", "$value": { "light": "#f1eee6", "dark": "#1f2229" } },
    "ink": { "$type": "color", "$value": { "light": "#1d1f24", "dark": "#e7e4dc" } },
    "muted": { "$type": "color", "$value": { "light": "#56595f", "dark": "#a9a69f" } },
    "rule": { "$type": "color", "$value": { "light": "#d9d5cb", "dark": "#343842" } },
    "accent": { "$type": "color", "$value": { "light": "#1f5fa8", "dark": "#8ab8f0" } },
    "accent-ink": { "$type": "color", "$value": { "light": "#ffffff", "dark": "#0d1420" } },
    "note": { "$type": "color", "$value": { "light": "#e6eef8", "dark": "#1b2a3d" } },
    "warning": { "$type": "color", "$value": { "light": "#fbeedd", "dark": "#3a2c18" } },
    "focus": { "$type": "color", "$value": { "light": "#b4570f", "dark": "#f2a35e" } }
  },
  "interactive": {
    "ink": { "$type": "color", "$value": { "light": "#3a3f47", "dark": "#0b0c0f" } },
    "paper": { "$type": "color", "$value": { "light": "#e9e4d8", "dark": "#cfc8b8" } }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "ui-monospace, 'SF Mono', 'Cascadia Code', 'DejaVu Sans Mono', monospace" }
  },
  "size": {
    "step--1": { "$type": "dimension", "$value": "clamp(0.83rem, 0.8rem + 0.15vw, 0.9rem)" },
    "step-0": { "$type": "dimension", "$value": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)" },
    "step-1": { "$type": "dimension", "$value": "clamp(1.2rem, 1.12rem + 0.4vw, 1.4rem)" },
    "step-2": { "$type": "dimension", "$value": "clamp(1.44rem, 1.3rem + 0.7vw, 1.75rem)" },
    "step-3": { "$type": "dimension", "$value": "clamp(1.73rem, 1.5rem + 1.15vw, 2.2rem)" }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "0.25rem" },
    "s": { "$type": "dimension", "$value": "0.5rem" },
    "m": { "$type": "dimension", "$value": "1rem" },
    "l": { "$type": "dimension", "$value": "2rem" },
    "xl": { "$type": "dimension", "$value": "4rem" }
  },
  "measure": { "$type": "dimension", "$value": "68ch" },
  "radius": { "$type": "dimension", "$value": "4px" }
}
