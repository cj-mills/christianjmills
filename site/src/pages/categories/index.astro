---
import Base from '../../layouts/Base.astro';
import { categoryGroups, deliverables } from '../../lib/site.ts';

const all = await deliverables();
const count = (term: string) => all.filter((d) => d.data.categories.includes(term)).length;
---

<Base title="Categories" description="Every category on the site, grouped by kind.">
  <h1>Categories</h1>
  {
    categoryGroups.map((g) => (
      <section aria-labelledby={`group-${g.key}`}>
        <h2 id={`group-${g.key}`}>{g.label}</h2>
        <ul>
          {g.terms
            .filter((t) => count(t) > 0)
            .map((t) => (
              <li>
                <a href={`/categories/${t}/`}>{t}</a> ({count(t)})
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>
