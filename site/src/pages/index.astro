---
import Base from '../layouts/Base.astro';
import { deliverables, formatDate } from '../lib/site.ts';

const all = await deliverables();
---

<Base title="Christian Mills" description="Writing, tutorials and interactive demos by Christian Mills.">
  <h1>Writing</h1>
  <ul class="listing">
    {
      all.map((d) => (
        <li>
          <h2><a href={d.data.urls.canonical}>{d.data.title}</a></h2>
          <p>{d.data.summary}</p>
          <p class="meta">
            <time datetime={d.data.published}>{formatDate(d.data.published)}</time> · {d.data.categories.join(', ')}
          </p>
        </li>
      ))
    }
  </ul>
</Base>
