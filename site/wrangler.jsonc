{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // An assets-only Worker: no Worker script, so pages are served as static assets and never run
  // Worker code (free-tier constraint, hub decision 2026-11-03-site-deliverable-contract).
  // Deployed to workers.dev for previews only; no route or custom domain points at it.
  "name": "christianjmills-site",
  "compatibility_date": "2026-10-20",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
