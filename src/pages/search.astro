---
import Base from '../layouts/Base.astro';
---

<Base title="Search" description="Search the site.">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <h1>Search</h1>
  <div class="search">
    <pagefind-input instance="site"></pagefind-input>
    <pagefind-summary instance="site"></pagefind-summary>
    <pagefind-results instance="site"></pagefind-results>
  </div>
  <noscript>
    <p>Search needs JavaScript. Without it, browse <a href="/">everything on the site</a> or <a href="/categories/">by category</a>.</p>
  </noscript>
  <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  <style is:global>
    .search {
      --pf-text: var(--color-ink);
      --pf-text-secondary: var(--color-muted);
      --pf-text-muted: var(--color-muted);
      --pf-background: var(--color-paper);
      --pf-border: var(--color-muted);
      --pf-border-focus: var(--color-focus);
      --pf-outline-focus: var(--color-focus);
      --pf-hover: var(--color-surface);
      --pf-mark: var(--color-ink);
      --pf-font: var(--font-text);
      --pf-border-radius: var(--radius);
    }
  </style>
</Base>
