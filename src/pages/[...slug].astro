---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contents, { type Item } from '../components/Contents.astro';
import { deliverables, formatDate, slugOf, updatedOf, type Deliverable } from '../lib/site.ts';
import ReferencesSwitch from '../components/ReferencesSwitch.astro';
import Sources from '../components/Sources.astro';

export async function getStaticPaths() {
  return (await deliverables()).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Deliverable };
const d = entry.data;
const { Content, headings } = await render(entry);
// The rail lists the page's sections: the post's own h2s, each with the cards under it, then the
// Sources the page adds.
const contents: Item[] = [];
for (const h of headings as { depth: number; slug: string; text: string; card?: boolean }[]) {
  if (h.depth === 2) contents.push({ slug: h.slug, text: h.text, items: [] });
  else if (h.card && contents.length) contents.at(-1)!.items!.push({ slug: h.slug, text: h.text });
}
if (d.sources.length > 0) contents.push({ slug: 'sources', text: 'Sources' });
const updated = updatedOf(entry);
const references = `${d.urls.canonical}references/`;
const hasNotes = d.notes.length > 0;
const hasCode = entry.rendered?.html.includes('class="code-block"') ?? false;
const hasSortedTable = entry.rendered?.html.includes('<table data-sort') ?? false;
---

<Base title={d.title} description={d.summary} markdown={`${d.urls.canonical}index.md`} section="writing">
  {/* Says scripts are running, before anything is drawn: a step list that is an interactive's
      fallback then shows its last step alone while the module loads (global.css, Step lists), and
      a code block with no language to name has its head ready for the copy button (Code). */}
  {(d.interactives.length > 0 || hasCode) && <script is:inline slot="head">document.documentElement.dataset.js = '';</script>}
  {/* A reader who has switched reference markers off gets the page without them from its first
      paint, so nothing moves when the script arrives (src/scripts/references.ts). */}
  {hasNotes && <script is:inline slot="head">try { if (localStorage.getItem('refs') === 'off') document.documentElement.dataset.refs = 'off'; } catch {}</script>}
  <article data-pagefind-body>
    <header>
      <h1>{d.title}</h1>
      <p class="standfirst">{d.summary}</p>
      <div class="meta">
        <p>
          Published <time datetime={d.published}>{formatDate(d.published)}</time>
          {updated !== d.published && <>, updated <time datetime={updated}>{formatDate(updated)}</time></>}
          {' · '}version {d.version}
        </p>
        <ul aria-label="Categories" data-pagefind-ignore>
          {d.categories.map((c) => <li><a href={`/categories/${c}/`}>{c}</a></li>)}
        </ul>
      </div>
      {contents.length > 1 && <Contents items={contents} place="head" />}
      {hasNotes && <ReferencesSwitch />}
    </header>

    <Content />

    {d.sources.length > 0 && <Sources d={d} references={hasNotes ? references : undefined} checked />}

    <footer class="meta" data-pagefind-ignore>
      <p>
        Prose: {d.licenses.prose.url ? <a href={d.licenses.prose.url}>{d.licenses.prose.spdx}</a> : d.licenses.prose.spdx}.
        Code: {d.licenses.code.spdx}.{' '}
        {d.testedAgainst.length > 0 && <>Tested against {d.testedAgainst.map((t) => `${t.name} ${t.version} (${formatDate(t.date)})`).join(', ')}.{' '}</>}
        <a href={`${d.urls.canonical}index.md`}>Markdown copy</a>.
      </p>
      {d.revisions.length > 1 && (
        <details>
          <summary>Revisions</summary>
          <ul>{d.revisions.map((r) => <li><time datetime={r.date}>{formatDate(r.date)}</time>, version {r.version}: {r.note}</li>)}</ul>
        </details>
      )}
    </footer>
  </article>

  {/* The aside: the contents rail, and under it the switch, both kept in view. */}
  {(contents.length > 1 || hasNotes) && (
    <div slot="aside" class="rail">
      {contents.length > 1 && <Contents items={contents} place="rail" />}
      {hasNotes && <ReferencesSwitch />}
    </div>
  )}

  {d.interactives.length > 0 && <script src="../scripts/interactives.ts"></script>}
  {hasNotes && <script src="../scripts/references.ts"></script>}
  {hasCode && <script src="../scripts/code.ts"></script>}
  {hasSortedTable && <script src="../scripts/tables.ts"></script>}
</Base>
