---
import { Font } from 'astro:assets';
import Mark from '../components/Mark.astro';
import { HOLDER, SITE_LICENSES } from '../lib/licenses.ts';
import { NAV, current, type Section } from '../lib/nav.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The page's Markdown copy for agents, if it has one. */
  markdown?: string;
  /** The section a page belongs to, when its address doesn't say: a post is in Writing. */
  section?: Section;
}
const { title, description, markdown, section } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
// The aside is the grid's last three columns, beside the main column, from 64em.
const hasAside = Astro.slots.has('aside');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Christian Mills' ? title : `${title} · Christian Mills`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta name="color-scheme" content="light dark" />
    {/* The fallback names only its 48 px image, though the file also holds 16 and 32 px ones.
        Desktop Chromium takes a bitmap icon whose `sizes` has its tab sizes (16 and 32 px) over an
        SVG, so naming them made the cave the tab icon. tools/check-icons.ts holds the rule. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Font cssVariable="--font-text" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-head" />
    <Font cssVariable="--font-code" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="frame masthead-in">
        <a class="site-name" href="/"><Mark size={24} />Christian Mills</a>
        <nav aria-label="Site">
          <ul>{NAV.map((n) => <li><a href={n.href} aria-current={current(n, path, section)}>{n.label}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <div class="frame page">
      <main id="main" class="page-main">
        <slot />
      </main>
      {hasAside && <aside class="page-aside"><slot name="aside" /></aside>}
    </div>
    <footer class="site-footer">
      <div class="frame">
        <div class="footer-top">
          <a class="site-name" href="/"><Mark size={24} />Christian Mills</a>
          <nav aria-label="Site, again">
            <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </nav>
        </div>
        <p class="license">
          © {HOLDER}. Writing is <a href={SITE_LICENSES.prose.url}>{SITE_LICENSES.prose.spdx}</a> and code is{' '}
          <a href={SITE_LICENSES.code.url}>{SITE_LICENSES.code.spdx}</a>, unless a page says otherwise.{' '}
          <a href="/licenses.txt">Third-party licenses</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
