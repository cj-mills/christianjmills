---
import { Font } from 'astro:assets';
import Mark from '../components/Mark.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The page's Markdown copy for agents, if it has one. */
  markdown?: string;
}
const { title, description, markdown } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Christian Mills' ? title : `${title} · Christian Mills`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Font cssVariable="--font-text" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-head" />
    <Font cssVariable="--font-code" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/"><Mark size={24} />Christian Mills</a>
      <nav aria-label="Site">
        <ul>
          <li><a href="/">Writing</a></li>
          <li><a href="/categories/">Categories</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Prototype build of the relaunched site: the page frame is not designed yet. <a href="/licenses.txt">Third-party licences</a>.</p>
    </footer>
  </body>
</html>
