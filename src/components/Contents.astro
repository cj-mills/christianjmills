---
// A page's contents, twice: a rail in the page's aside where the grid has one, and a closed
// disclosure under the page's head where it doesn't. The stylesheet shows one or the other, so each
// page reads one list (the hidden one is display: none, out of the accessibility tree too).
export interface Item {
  slug: string;
  text: string;
  /** A section's cards, listed under it. */
  items?: Item[];
}
interface Props {
  items: Item[];
  /** Where this copy goes: the aside's rail or the head's disclosure. */
  place: 'rail' | 'head';
}
const { items, place } = Astro.props;
const list = (all: Item[]) => all.map((i) => ({ ...i, items: i.items ?? [] }));
---

{
  place === 'rail' ? (
    <nav class="contents contents-rail" aria-label="Contents">
      <p class="contents-title" aria-hidden="true">Contents</p>
      <ol>
        {list(items).map((i) => (
          <li>
            <a href={`#${i.slug}`}>{i.text}</a>
            {i.items.length > 0 && <ol>{i.items.map((c) => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}</ol>}
          </li>
        ))}
      </ol>
    </nav>
  ) : (
    <details class="contents contents-head">
      <summary>Contents</summary>
      <nav aria-label="Contents">
        <ol>
        {list(items).map((i) => (
          <li>
            <a href={`#${i.slug}`}>{i.text}</a>
            {i.items.length > 0 && <ol>{i.items.map((c) => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}</ol>}
          </li>
        ))}
      </ol>
      </nav>
    </details>
  )
}

{place === 'rail' && <script src="../scripts/contents.ts"></script>}
