---
// The mark in one color, from the theme (currentColor). Its size follows the lockup rule of the
// design lab's mark round: twice the name's cap height, rounded to a multiple of the 8-unit
// lattice, with its baseline on the name's and a quarter of its height as the gap.
import { BASELINE, PATH, UNITS } from '../lib/mark.ts';

interface Props {
  /** CSS pixels; a multiple of 8. */
  size: number;
}
const { size } = Astro.props;
if (size % UNITS) throw new Error(`Mark: size ${size} is not a multiple of ${UNITS}`);
const drop = (size * (UNITS - BASELINE)) / UNITS;
---

<svg
  class="mark"
  viewBox={`0 0 ${UNITS} ${UNITS}`}
  width={size}
  height={size}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
  style={`vertical-align:-${drop}px;margin-right:${size / 4}px`}
><path d={PATH} fill="currentColor"></path></svg>
