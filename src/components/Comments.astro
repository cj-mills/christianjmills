---
// A post's comments: nothing from giscus.app loads until the reader presses the button
// (src/scripts/comments.ts). Without scripts the button is hidden by the stylesheet and the link
// takes the reader to the thread on GitHub. The head's `data-js` is set before the first paint, so
// the button is there from the start and nothing moves when the script arrives.
import { threadOf } from '../lib/comments.ts';

interface Props {
  id: string;
  discussion?: number;
}
const { id, discussion } = Astro.props;
const t = threadOf(id, discussion);
---

<section class="comments" aria-labelledby="comments" data-mapping={t.mapping} data-term={t.term} data-pagefind-ignore>
  <h2 id="comments">Comments</h2>
  <p>
    <button type="button" class="comments-load">Show comments</button>
    They are GitHub Discussions, shown here by giscus. <a href={t.href}>Open them on GitHub</a>.
  </p>
</section>
